OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, e.g. https://api.openai.com/v1/chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
PORT=3001
NODE_ENV=development
